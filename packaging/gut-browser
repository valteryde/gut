#!/bin/sh
# gut browser launcher — installed as /usr/local/bin/google-chrome, which
# shadows /usr/bin so every launch path resolves here: the agent daemon
# (`nohup google-chrome`), XFCE exo-open/xdg-open via the gut-browser
# helper, and .desktop icons.
#
# Picks the first *real* browser and forces the flags the agent needs:
# --no-sandbox (gut-bot hosts often lack unprivileged user namespaces), CDP
# on localhost:9222 for the browser_* tools, a dedicated profile dir
# (Chrome 136+ ignores --remote-debugging-port on the default profile), and
# a UI scale bump so page text survives screenshot downscaling.
#
# Snap stubs are skipped: Ubuntu's `chromium` deb is a transitional package
# that execs the snap, and snap-confined apps die with EIO on VPSes without
# squashfs/loop support — ensure-browser.sh installs real Chrome there.

FLAGS="--no-sandbox --disable-setuid-sandbox \
--remote-debugging-address=127.0.0.1 --remote-allow-origins=* \
--remote-debugging-port=${CDP_PORT:-9222} \
--user-data-dir=${HOME:-/var/lib/gut}/.gut-chrome \
--force-device-scale-factor=${UI_SCALE:-1.25}"

is_snap() {
  case "$(readlink -f "$1" 2>/dev/null)" in
    /snap/*|/var/lib/snapd/*) return 0 ;;
  esac
  # Ubuntu's transitional debs leave a shell script that defers to the snap
  head -c 4096 "$1" 2>/dev/null | grep -q 'snap run'
}

for b in /usr/bin/google-chrome-stable /usr/bin/google-chrome \
         /opt/google/chrome/google-chrome; do
  [ -x "$b" ] && exec "$b" $FLAGS "$@"
done

for c in /usr/bin/chromium /usr/bin/chromium-browser; do
  [ -e "$c" ] && ! is_snap "$c" && exec "$c" $FLAGS "$@"
done

# last resort: whatever chromium is reachable (may still be the snap stub —
# a broken snap fails the same way it would have anyway)
c="$(command -v chromium || command -v chromium-browser || true)"
[ -n "$c" ] && exec "$c" $FLAGS "$@"

echo "gut-browser: no usable browser found" >&2
exit 1
