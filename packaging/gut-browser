#!/bin/sh
# gut browser launcher — installed as /usr/local/bin/google-chrome, which
# shadows /usr/bin so every launch path resolves here: the agent daemon
# (`nohup google-chrome`), XFCE exo-open/xdg-open via the gut-browser
# helper, and .desktop icons.
#
# Picks the first *working* browser and forces the flags the agent needs:
# --no-sandbox (gut-bot hosts often lack unprivileged user namespaces), CDP
# on localhost:9222 for the browser_* tools, a dedicated profile dir
# (Chrome 136+ ignores --remote-debugging-port on the default profile), and
# a UI scale bump so page text survives screenshot downscaling.
#
# Snap stubs are skipped: Ubuntu's `chromium`/`firefox` debs are
# transitional packages that exec the snap, and snap-confined apps die with
# EIO on VPSes without squashfs/loop support. ensure-browser.sh provisions
# real Chrome / Chrome-for-Testing / Mozilla-repo firefox instead.
#
# Firefox is a last resort: it's a working desktop browser but has no CDP
# (removed in 141), so the agent's browser_* tools only work on the
# Chromium-family candidates above it.

CHROME_FLAGS="--no-sandbox --disable-setuid-sandbox \
--no-first-run --no-default-browser-check \
--remote-debugging-address=127.0.0.1 --remote-allow-origins='*' \
--remote-debugging-port=${CDP_PORT:-9222} \
--user-data-dir=${HOME:-/var/lib/gut}/.gut-chrome \
--force-device-scale-factor=${UI_SCALE:-1.25}"

is_snap() {
  case "$(readlink -f "$1" 2>/dev/null)" in
    /snap/*|/var/lib/snapd/*) return 0 ;;
  esac
  # Ubuntu's transitional debs leave a shell script that defers to the snap —
  # it execs /snap/bin/chromium directly and never spells out "snap run".
  head -c 4096 "$1" 2>/dev/null | grep -qE 'snap run|/snap/|snapd|snap install'
}

# A browser that can't even print its version (missing libs, truncated
# payload) is worse than absent — it would exec-fail or hang mid-launch.
# A snap stub can still print a version ending in "snap" when probed as
# root, so reject that output too.
runnable() {
  out="$(timeout 15 "$1" --version 2>/dev/null)" || return 1
  case "$out" in *[Ss]nap*) return 1 ;; esac
  return 0
}

# CDP-capable candidates, best first: real Chrome, Chrome for Testing
# (provisioned by ensure-browser.sh into /opt/gut/browsers), real chromium.
for b in /usr/bin/google-chrome-stable /usr/bin/google-chrome \
         /opt/google/chrome/google-chrome \
         /opt/gut/browsers/cft/chrome; do
  case "$b" in
    /usr/bin/google-chrome) [ -e "$b" ] && is_snap "$b" && continue ;;
  esac
  [ -x "$b" ] && runnable "$b" && exec "$b" $CHROME_FLAGS "$@"
done

for c in /usr/bin/chromium /usr/bin/chromium-browser; do
  [ -e "$c" ] && ! is_snap "$c" && runnable "$c" \
    && exec "$c" $CHROME_FLAGS "$@"
done

# GUI fallback: a real (non-snap) firefox. No CDP, but the user gets a
# browser that opens; MOZ_*_SANDBOX keeps it alive without user namespaces.
for f in /usr/bin/firefox /usr/bin/firefox-esr; do
  if [ -x "$f" ] && ! is_snap "$f" && runnable "$f"; then
    P="${HOME:-/var/lib/gut}/.gut-firefox"
    mkdir -p "$P"
    touch "$P/user.js"
    sed -i '/layout\.css\.devPixelsPerPx/d' "$P/user.js"
    printf 'user_pref("layout.css.devPixelsPerPx", "%s");\n' \
      "${UI_SCALE:-1.25}" >> "$P/user.js"
    MOZ_DISABLE_CONTENT_SANDBOX=1 MOZ_DISABLE_GMP_SANDBOX=1 \
    MOZ_DISABLE_RDD_SANDBOX=1 MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1 \
      exec "$f" -profile "$P" "$@"
  fi
done

# last resort: whatever chromium is reachable (may still be the snap stub —
# a broken snap fails the same way it would have anyway)
c="$(command -v chromium || command -v chromium-browser || true)"
[ -n "$c" ] && exec "$c" $CHROME_FLAGS "$@"

echo "gut-browser: no usable browser found" >&2
exit 1
