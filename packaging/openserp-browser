#!/bin/sh
# Browser launcher for OpenSERP (gut-bot) — installed as
# /opt/gut/openserp-browser and passed via --browser-path.
#
# Same candidate order and snap-stub detection as packaging/gut-browser, but
# adds ONLY --no-sandbox: OpenSERP's go-rod launcher supplies its own
# debugging port, temp profile dir and headless flags. Reusing the
# gut-browser wrapper would force CDP on :9222 and the agent's shared
# ~/.gut-chrome profile — colliding with the desktop's own Chrome session.

is_snap() {
  case "$(readlink -f "$1" 2>/dev/null)" in
    /snap/*|/var/lib/snapd/*) return 0 ;;
  esac
  # Ubuntu's transitional debs leave a shell script that defers to the snap —
  # it execs /snap/bin/chromium directly and never spells out "snap run".
  head -c 4096 "$1" 2>/dev/null | grep -qE 'snap run|/snap/|snapd|snap install'
}

# A browser that can't even print its version (missing libs, truncated
# payload) is worse than absent — it would exec-fail or hang mid-launch.
# A snap stub can still print a version ending in "snap" when probed as
# root, so reject that output too.
runnable() {
  out="$(timeout 15 "$1" --version 2>/dev/null)" || return 1
  case "$out" in *[Ss]nap*) return 1 ;; esac
  return 0
}

# CDP-capable candidates, best first: real Chrome, Chrome for Testing
# (provisioned by ensure-browser.sh into /opt/gut/browsers), real chromium.
for b in /usr/bin/google-chrome-stable /usr/bin/google-chrome \
         /opt/google/chrome/google-chrome \
         /opt/gut/browsers/cft/chrome \
         /usr/bin/chromium /usr/bin/chromium-browser; do
  [ -e "$b" ] && ! is_snap "$b" && runnable "$b" \
    && exec "$b" --no-sandbox --disable-setuid-sandbox "$@"
done

echo "openserp-browser: no usable browser found" >&2
exit 1
