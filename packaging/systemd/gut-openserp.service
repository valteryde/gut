[Unit]
Description=OpenSERP search API for the Gut agent (web_search backend)
After=network-online.target

[Service]
Type=simple
User=gut
Group=gut
Environment=HOME=/var/lib/gut
# Localhost-only: the daemon reaches it at OPENSERP_URL (see gut-bot.env).
# --leakless closes the per-query browser instances it spawns; the browser
# launcher resolves a real (non-snap) Chrome/Chromium and adds --no-sandbox,
# which many VPS kernels require.
ExecStart=/opt/gut/openserp serve -a 127.0.0.1 -p 7070 --leakless \
    --browser-path /opt/gut/openserp-browser
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
