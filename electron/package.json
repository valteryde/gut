{
  "name": "gut",
  "productName": "gut",
  "version": "0.11.0",
  "description": "Self-hosted AI desktop agent",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/brand-electron.cjs",
    "icons": "scripts/make-icons.sh",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.gut.app",
    "directories": { "output": "dist" },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": ["main.js", "preload.js", "localstack.js", "updater.js", "tls.js"],
    "extraResources": [
      { "from": "../client", "to": "client" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "target": ["dmg", "zip"],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "gut connects to Gut backends on your local network — the desktop stream and agent API run on machines you point it at.",
        "NSBonjourServices": ["_http._tcp", "_ws._tcp", "_https._tcp", "_wss._tcp"]
      }
    },
    "win": {
      "icon": "resources/icon.png",
      "target": ["nsis"]
    },
    "linux": {
      "category": "Utility",
      "icon": "resources/icon.png",
      "target": ["AppImage"]
    }
  }
}
