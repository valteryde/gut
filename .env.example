# .env is for bootstrap SECRETS ONLY — the three values below. Provider keys
# live on the device in provider_keys.json (Settings → Provider keys, or
# POST /api/keys); everything else lives in config.json on the data volume
# (POST /api/config — see the reference at the bottom of this file).

# ── Secrets ────────────────────────────────────────────────────────────────

# Admin/master key for the LiteLLM proxy. MUST start with "sk-".
# Generate one:  openssl rand -hex 32 | sed 's/^/sk-/'
LITELLM_MASTER_KEY=sk-change-me

# Postgres password for LiteLLM's internal spend-tracking DB.
POSTGRES_PASSWORD=litellm-db-password

# One password protects the desktop stream AND the agent API (port 8000).
# EMPTY = no auth (localhost only!). Always set this on a VPS.
GUT_PASSWORD=


# ── Provider keys — set these in the app, not here ─────────────────────────
# The daemon registers each provider's models with LiteLLM at boot from the
# device's provider_keys.json. Push them from Settings → Provider keys or:
#   POST /api/keys  {"keys": {"OPENROUTER_API_KEY": "..."}}
# Known key names: ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY,
# DEEPSEEK_API_KEY, OPENROUTER_API_KEY, OLLAMA_API_BASE.
# (Env vars with the same names still work as a fallback for automation.)


# ── Runtime config — reference only, don't store it here ───────────────────
# These are read from the device's config.json, managed via:
#   GET  /api/config                  → stored + effective values
#   POST /api/config {"config": {"AGENT_MAX_USD": "0.5"}}   → hot-applies
# Keys marked [boot] take effect on the next container start; everything
# else applies live. Env vars remain deploy-time defaults — a value in
# config.json overrides them.
#
# Desktop & models
#   RESOLUTION=1024x768          [boot] virtual desktop WxH — smaller = cheaper
#                                screenshot tokens; 800x600 halves them again
#   UI_SCALE=1.25                [boot] Xft DPI / device-scale-factor — bigger
#                                widgets are easier click targets
#   DEFAULT_MODEL=openrouter/qwen3-vl-30b   starting model (vision-capable)
#   ESCALATION_MODEL=openrouter/claude-sonnet-4.5   stronger model a stuck or
#                                failing run switches to; empty = never
#   ESCALATION_RESCUES=2         unstick attempts before escalating
#   AGENT_CYCLE_WINDOW=12        acting calls in a row that were all seen
#                                earlier in the run = a loop; the whole cycle
#                                is disabled and a rescue spent
#   NORMALIZED_COORD_MODELS=qwen3-vl,gemini   substrings for models that emit
#                                0-1000 grid coords instead of pixels
#
# Cost ceilings
#   AGENT_MAX_USD=0              per-run dollar cap, 0 = no cap
#   AGENT_MAX_STEPS=150          per-run step cap
#   AGENT_WRAP_UP_STEPS=10       steps before the cap the run is told to stop
#                                exploring and deliver what it has
#   AGENT_IDLE_REPLY_LIMIT=3     idle "anything else?" replies before stopping
#   TOOL_RESULT_HISTORY=8        stale tool outputs get truncated past this
#   TOOL_RESULT_STUB_CHARS=300   chars kept of each truncated result
#   SCREENSHOT_MAX_EDGE=1568     frame caps — keep under provider rescale
#   SCREENSHOT_MAX_PIXELS=1000000  thresholds or click coords land off-target
#   SCREENSHOT_AUTO_PIXELS=0     lower cap for auto "did it change?" frames
#   SCREENSHOT_HISTORY=3         recent frames kept in context
#   COMPACT_MODEL=               text-only history summarizer, e.g.
#                                openrouter/deepseek-v3.2
#   JANITOR_MODEL=               post-run cleanup model, needs vision
#   SUBAGENT_MODEL=              headless helper model (no vision needed)
#   VERIFY_MODEL=                wrap-up checker (text-only); empty =
#                                COMPACT_MODEL or the run's model
#
# Behavior
#   AGENT_VERIFY=on              audit task_complete summaries against the
#                                run's tool log — claims with no tool result
#                                behind them bounce back to be fixed
#   AGENT_VERIFY_MAX_REJECTS=2   bounces before the wrap-up is accepted with
#                                the checker's caveats shown to the user
#   AGENT_VERIFY_MIN_CALLS=4     runs with fewer tool calls skip the audit
#   AGENT_VERIFY_INPUT_CHARS=120000   tool-log budget for the checker call
#   AGENT_VERIFY_RESULT_CHARS=400     chars of each tool result in the log
#   GUT_CLEANUP=on               close what the run opened + janitor pass
#   JANITOR_MAX_STEPS=10
#   SUBAGENT_MAX_STEPS=40
#   SUBAGENT_MAX_CONCURRENT=4
#   AGENT_COMPACT_RATIO=0.75     compact when input exceeds this fraction of
#   AGENT_CONTEXT_LIMIT=128000   the model's context window
#   AGENT_COMPACT_KEEP=6
#   AGENT_COMPACT_INPUT_CHARS=400000
#   TODO_REMIND_STEPS=20         nudge the checklist after N idle steps
#   TODO_NUDGE_STEPS=10
#   TODO_MAX_ITEMS=30
#   ACTION_SETTLE_SECS=1.5       wait-for-repaint after screen actions
#   INTER_ACTION_DELAY=0.35      gap between batched screen actions
#   CLICK_A11Y=on                report what a click landed on (AT-SPI)
#   CLICK_SNAP_PX=24             snap dead-space clicks to nearby elements
#   SCROLL_MAX_CLICKS=20         wheel clicks per scroll call (models pass
#                                pixel counts — 500 jumps to the page end)
#   LLM_MAX_RETRIES=4
#   ASK_USER_TIMEOUT=600
#   COMMAND_TIMEOUT=60
#   SEND_FILE_MAX_BYTES=9437184
#   ATTACH_TOTAL_MAX_BYTES=12582912
#   OPENSERP_URL=                web_search endpoint; empty = DuckDuckGo.
#                                Also renders JS-heavy pages for fetch_url
#   OPENSERP_ENGINES=            engines for openserp's megasearch, e.g.
#                                google,bing,duckduckgo,yandex,baidu,ecosia;
#                                empty = picked per query language (Baidu
#                                and Yandex only for their own languages)
#   SEARCH_LANG=                 optional web_search locale fallback passed
#   SEARCH_REGION=               to openserp/DDG, e.g. DA + DK — the agent
#                                sets lang/region per query from the request's
#                                language, so these are rarely needed (also in
#                                Settings → Device settings)
#
# Device
#   DEVICE_NAME=local            [boot] display name (also picks wallpaper hue)
#   WALLPAPER_HUE=               [boot] 0-360, pins the wallpaper color
#   CDP_PORT=9222                [boot] Chrome DevTools port — localhost only
#   GUT_UNO_PORT=2002            [boot] LibreOffice UNO port — localhost only


# ── Ports (compose-level, still fine here) ─────────────────────────────────
# There is no browser client anymore — the Electron app is the UI.
AGENT_PORT=8000         # agent daemon REST + WebSocket
NOVNC_PORT=6080         # noVNC/websockify desktop stream
NOVNC_TLS_PORT=6443     # pinned self-signed endpoints the app prefers
AGENT_TLS_PORT=8443
LITELLM_PORT=4000       # LiteLLM proxy + admin UI (/ui)
