# ── LiteLLM ────────────────────────────────────────────────────────────────
# Admin/master key for the LiteLLM proxy. MUST start with "sk-".
# Generate one:  openssl rand -hex 32 | sed 's/^/sk-/'
LITELLM_MASTER_KEY=sk-change-me

# Postgres password for LiteLLM's internal spend-tracking DB.
POSTGRES_PASSWORD=litellm-db-password

# ── Provider keys (BYOK — fill in whichever you use, leave the rest blank) ──
# The daemon registers each key's models with LiteLLM at boot. Keys can also
# be pushed at runtime from the app's Settings → Provider keys (stored on the
# device, no restart needed).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_API_BASE=http://host.docker.internal:11434   # for local Ollama models

# ── Desktop ────────────────────────────────────────────────────────────────
# Size of the virtual desktop (WxH). Smaller = cheaper screenshot tokens;
# ~1024x768 is the sweet spot for computer-use models, 800x600 is ~half the
# image tokens again but cramped.
RESOLUTION=1024x768

# Screenshot caps applied before sending frames to the vision model. Keep
# under provider rescale thresholds (Anthropic: 1568px long edge / ~1.15MP) —
# if the API rescales silently, click coordinates land off-target.
SCREENSHOT_MAX_EDGE=1568
SCREENSHOT_MAX_PIXELS=1000000

# How many recent screenshots stay in the model's context; older frames are
# swapped for text placeholders. Lower = cheaper, higher = more visual memory.
SCREENSHOT_HISTORY=3

# UI scale factor (Xft DPI + Chrome device-scale-factor). Only worth >1 when
# screenshots get downscaled (RESOLUTION above ~1568px); at 1024x768 frames
# go to the model at native size and 1.0 leaves more room on screen.
UI_SCALE=1.0

# Chrome DevTools port for the browser_* DOM tools. Localhost-only inside the
# desktop container — never publish it (CDP is full remote control).
CDP_PORT=9222

# LibreOffice UNO listener port for the office_eval tool — injected into
# every soffice/libreoffice launch by the /usr/local/bin wrapper.
# Localhost-only for the same reason as CDP.
GUT_UNO_PORT=2002

# OpenSERP endpoint for the agent's web_search tool. The compose stack already
# sets this to its internal openserp service; set it only to point at your own
# instance. Empty = web_search falls back to DuckDuckGo's HTML endpoint.
# OPENSERP_URL=http://openserp:7070

# One password protects the desktop stream AND the agent API (port 8000).
# EMPTY = no auth (localhost only!). Always set this on a VPS.
GUT_PASSWORD=

# Max size (bytes) of files/images the agent can send you in chat via
# send_file / send_image. Keep under ~12MB — attachments travel the chat
# WebSocket as base64 and uvicorn's default frame limit is 16MB.
SEND_FILE_MAX_BYTES=9437184

# Model the agent starts with (must exist in litellm_config.yaml and be
# vision-capable for screenshot perception). Can be switched per conversation.
DEFAULT_MODEL=claude-sonnet-4-5

# End-of-run cleanup: after every task the daemon closes the browser tabs,
# windows and processes the run created and wipes ~/scratch, then a short
# janitor pass (a bounded LLM loop, max JANITOR_MAX_STEPS steps) tidies
# whatever's left. Logins/cookies persist — only what the run opened goes.
# off = leave the desktop exactly as the agent left it.
GUT_CLEANUP=on
JANITOR_MAX_STEPS=10

# Models whose click/move coordinates arrive on a normalized 0-1000 grid
# instead of screenshot pixels (Qwen3-VL, Gemini 2.5). Comma-separated
# substrings matched against the model id; empty = treat all as pixels.
NORMALIZED_COORD_MODELS=qwen3-vl,gemini

# Display name for this backend when the web client lists it as a "device".
# One agent runs per device; run several stacks for parallel agents.
# The name also picks the desktop wallpaper's hue so every device looks
# different at a glance; pin a color (0-360 deg) with WALLPAPER_HUE.
DEVICE_NAME=local
# WALLPAPER_HUE=

# ── Subagents ────────────────────────────────────────────────────────────
# The agent can spawn background helper agents (spawn_agent) for headless
# subtasks — web search/fetch, files, shell commands — while it keeps
# driving the desktop. Helpers get no screen, no browser and no user
# contact; their reports arrive as messages in the run.
SUBAGENT_MAX_STEPS=40        # per-helper step cap
SUBAGENT_MAX_CONCURRENT=4    # helpers running at once
# SUBAGENT_MODEL=            # empty = same model as the main agent

# ── Long runs ────────────────────────────────────────────────────────────
# Automatic context compaction: when a request's input exceeds
# AGENT_COMPACT_RATIO of the model's context window, history is summarized
# into a handoff note and the run continues on summary + checklist + the
# last AGENT_COMPACT_KEEP messages. AGENT_CONTEXT_LIMIT is the assumed
# window when LiteLLM reports no max_input_tokens for the model.
AGENT_COMPACT_RATIO=0.75
AGENT_CONTEXT_LIMIT=128000
AGENT_COMPACT_KEEP=6
# Steps without an update_todos call before the agent is reminded to keep
# its checklist current. TODO_NUDGE_STEPS is the same nudge for a run that
# has no checklist at all — it fires sooner to bootstrap one.
TODO_REMIND_STEPS=20
TODO_NUDGE_STEPS=10

# ── Ports ──────────────────────────────────────────────────────────────────
# There is no browser client anymore — the Electron app is the UI.
AGENT_PORT=8000         # agent daemon REST + WebSocket
NOVNC_PORT=6080         # noVNC/websockify desktop stream
LITELLM_PORT=4000       # LiteLLM proxy + admin UI (/ui)
